# ==============================================================================
# FINCORE Life Insurance Broking Platform - Production & Development Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fincore
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fincore
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fincore

# Redis Configuration (Session caching, rate limiting, and event queues)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptographic Tokens
# In production, generate a secure random 256-bit key: openssl rand -hex 32
SECRET_KEY=fincore_super_secret_jwt_key_change_in_production_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Metadata & Runtime
PROJECT_NAME="FINCORE Insurance Broking Core API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "http://localhost:3000"]

# Regulatory Broker Details (IRDAI Direct Broker - Life)
DEFAULT_ORG_NAME="FINCORE Insurance Broking Services Pvt. Ltd."
DEFAULT_ORG_CODE="fincore-brokerage"
IRDAI_REG_NUMBER="IRDAI/DB/892/2024"

# AI / ML & LLM Settings
# If GEMINI_API_KEY is not set or empty, system seamlessly runs on DeterministicFallbackLLMProvider (zero-cost offline mode)
GEMINI_API_KEY=
ML_LEAD_SCORING_VERSION="v1.2-hybrid"
ML_MIN_TRAINING_SAMPLES=1000
