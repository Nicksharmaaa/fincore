# ==============================================================================
# FINCORE Life Insurance Broking Platform - Backend Environment Configuration
# ==============================================================================

# Application Meta
PROJECT_NAME="FINCORE Insurance Broking Core API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Tokens
# CAUTION: Generate a secure random 256-bit key in production
SECRET_KEY="fincore_super_secret_jwt_key_change_in_production_2026_secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fincore"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/fincore"

# Local SQLite Fallback (set to true only if running without local PostgreSQL)
SQLITE_DB_PATH="./fincore.db"
USE_SQLITE_FALLBACK=false

# Regulatory Organization Defaults (IRDAI Direct Broker)
DEFAULT_ORG_NAME="FINCORE Insurance Broking Services Pvt. Ltd."
DEFAULT_ORG_CODE="fincore-brokerage"
IRDAI_REG_NUMBER="IRDAI/DB/892/2024"
